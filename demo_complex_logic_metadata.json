{
  "source_code": "\ndef analyze_data(data, threshold=10):\n    results = []\n    \n    if not data:\n        return results\n    \n    for item in data:\n        try:\n            if item > threshold:\n                processed = item * 2\n                results.append(processed)\n            elif item == threshold:\n                results.append(item)\n            else:\n                results.append(0)\n        except Exception as e:\n            print(f\"Error processing {item}: {e}\")\n    \n    return results\n\ndata = [5, 15, 10, 20, 3, 12]\nanalyzed = analyze_data(data)\nprint(f\"Results: {analyzed}\")\n",
