; scheduler_final2.glyph
; Demonstrates preemptive multi-processing via a Timer IRQ (IRQ 1).
; FINAL VERSION v2: Initialize BOTH P0 and P1 PCBs before enabling interrupts.

VECTOR 1 :scheduler_isr

:boot
; 1. Initialize P1's Process Control Block (PCB) at (30, 240)
SET 0
STORE (3, 0)  ; Reset SP
CALL :p1_init

; 2. Initialize P0's Process Control Block (PCB) at (20, 240)
; We need to save the state for the currently running P0 code
SET 0
STORE (3, 0)  ; Reset SP again
CALL :p0_init

; 3. Load P0 and jump to its entry point (skip initialization code)
CTX_LOAD (20, 240)
JMP :p0_start
; -----------------

:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start
; -----------------

:p1_init
; CTX_SAVE peeks the return address and saves it to P1's PCB!
CTX_SAVE (30, 240)
JMP :boot_continue

:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start
; -----------------

:p0_init
; CTX_SAVE peeks the return address and saves it to P0's PCB!
CTX_SAVE (20, 240)
JMP :boot_continue

:boot_continue
; Check which PCB we just initialized by looking at PC
LOAD (0, 0)  ; We can't easily distinguish - use flag instead
; Actually, we need two different boot continues...
; This approach won't work. Let me redesign.

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET