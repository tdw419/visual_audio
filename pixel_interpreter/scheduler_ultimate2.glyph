; scheduler_ultimate2.glyph
; FIX: boot_continue jumps to p0_start after CTX_LOAD.

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Initialize P1's PCB
CALL :p1_init

; Initialize P0's PCB
SET 0
STORE (3, 0)
CALL :p0_init

; Restore P0 state
CTX_LOAD (20, 240)

; Set PID = 0 and enable interrupts
SET 0
STORE (100, 0)
SEI

; Jump to P0 (the CTX_LOAD pushed PC to stack, but we want to ignore it and jump directly)
JMP :p0_start

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

:p0_init
CTX_SAVE (20, 240)
JMP :boot_init_done

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

:p1_init
CTX_SAVE (30, 240)
JMP :boot_init_done

:boot_init_done
NOP  ; Dummy - execution continues to next instruction

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET