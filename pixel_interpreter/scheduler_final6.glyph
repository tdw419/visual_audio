; scheduler_final6.glyph
; FINAL VERSION v6: Use correct STORE_XY syntax.

VECTOR 1 :scheduler_isr

:boot
; 1. Initialize P1's PCB at column 30, rows 240-243
; STORE_XY syntax: STORE_XY x y (where x=src_a, y=src_b are packed in G,B)
; But we write to (dst, src_b) location

; Initialize PCB[PC] = (1, 1) at (30, 240)
STORE_XY (30, 240) 1 1
; Initialize PCB[Acc] = 0 at (31, 240)
SET 0
STORE (31, 240)
; Initialize PCB[SP] = 0 at (32, 240)
SET 0
STORE (32, 240)
; Initialize PCB[ZF] = 0 at (33, 240)
SET 0
STORE (33, 240)

; 2. Initialize P0's PCB at column 20, rows 240-243
; Initialize PCB[PC] = (10, 1) at (20, 240)
STORE_XY (20, 240) 10 1
SET 0
STORE (21, 240)
SET 0
STORE (22, 240)
SET 0
STORE (23, 240)

; 3. Set current PID and enable interrupts
SET 0
STORE (100, 0)
SEI

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET