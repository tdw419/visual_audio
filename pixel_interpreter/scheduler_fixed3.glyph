; scheduler_fixed3.glyph - Manually build P1's PCB with correct PC
; Key: Don't use CTX_SAVE for init - it peeks stack which has wrong address

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Manually build P1's PCB at (30, 240)
; PC = p1_start (assembled at 18, 1)
SET 18
STORE (30, 240)  ; R channel = PC.x
SET 1
STORE (31, 240)  ; G channel = PC.y (at y=240, x=31 - need different approach)

; Better: Use STORE_XY which writes both X and Y to a cell
; But STORE_XY's dest is from immediate, needs a trick
SET 18
SET_ADDR_HIGH  ; Acc = 18 << 8
SET 1
SET_ADDR_LOW   ; Acc = 18*256 + 1 = 4609
INDIRECT_STORE  ; Store Acc value to (30, 240) - wait, no src

; Simplest: Just use STORE for both channels
SET 18
STORE (30, 240)  ; R = 18 (PC.x)
SET 1
SET_ADDR_LOW    ; Now Acc = 1
; Can't use STORE to write G channel of same cell - STORE overwrites R only

; Use SET_ADDR tricks to build packed value
SET 18
SET_ADDR_HIGH   ; Acc = 18 << 8 = 4608
SET 1
SET_ADDR_LOW    ; Acc = 4608 | 1 = 4609
; Need to write this to (30, 240) but need src for INDIRECT_STORE
; Let's just rely on CTX_SAVE for init - we need to fix CTX_SAVE

; Actually, the problem is CTX_SAVE peeks wrong stack value.
; Solution: Manually init both PCBs with correct addresses
SET 14
STORE (20, 240)  ; P0 PC = (14, 1) where p0_start will be
SET 1
STORE (21, 240)  ; P0 PC.y
SET 18
STORE (30, 240)  ; P1 PC = (18, 1)
SET 1
STORE (31, 240)  ; P1 PC.y

; Set PID = 0 and enable interrupts
SET 0
STORE (100, 0)
SEI

; Jump to P0
JMP :p0_start

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
; Interrupt pushed return address to stack. POP it before CTX_LOAD.
POP

LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
; P1 was running. Save P1, Load P0.
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
; P0 was running. Save P0, Load P1.
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET