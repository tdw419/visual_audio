; scheduler_ultimate5.glyph
; FINAL: Only initialize P1's PCB. P0's PCB gets initialized by first CTX_SAVE.

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Initialize P1's PCB using the trick: JMP to p1_start and CTX_SAVE immediately
JMP :p1_init

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

:p1_init
; We need to save the state as if we had just entered p1_start
; But CTX_SAVE peeks the stack, so we need to push a return address first
; The trick: CALL into a dummy function that CTX_SAVEs
CALL :p1_save_state

:p1_save_state
; CTX_SAVE peeks stack and saves the return address to P1's PCB
CTX_SAVE (30, 240)
; Return to boot
RET

:boot_continue
; Set PID = 0 and enable interrupts
SET 0
STORE (100, 0)
SEI

; Jump to P0 (no PCB needed yet - will be saved on first switch)
JMP :p0_start

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET