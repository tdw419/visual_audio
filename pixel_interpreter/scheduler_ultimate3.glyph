; scheduler_ultimate3.glyph
; FINAL ATTEMPT: Let P0 run naturally, first IRQ saves it.

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Initialize P1's PCB (P0 will be saved by first IRQ)
CALL :p1_init

; Set PID = 0 and enable interrupts
SET 0
STORE (100, 0)
SEI

; Jump to P0 (no PCB needed yet - will be saved on first switch)
JMP :p0_start

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

:p1_init
CTX_SAVE (30, 240)
NOP
; Returns to boot, which continues

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
; P1 was running. Save P1, Load P0.
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
; P0 was running. Save P0, Load P1.
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET