; scheduler_ultimate6.glyph
; FIX: p1_save_state should JMP to p1_start after saving, not RET.

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Initialize P1's PCB
CALL :p1_save_state

; Set PID = 0 and enable interrupts
SET 0
STORE (100, 0)
SEI

; Jump to P0
JMP :p0_start

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

:p1_save_state
; Save the return address (which is p1_start) to P1's PCB
CTX_SAVE (30, 240)
; Return to boot (P1 will be loaded on first context switch)
RET

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET