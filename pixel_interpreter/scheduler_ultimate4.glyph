; scheduler_ultimate4.glyph
; FIX: JMP instead of CALL, so CTX_SAVE saves the right PC.

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Initialize P1's PCB
JMP :p1_init

:boot_continue
; Set PID = 0 and enable interrupts
SET 0
STORE (100, 0)
SEI

; Jump to P0
JMP :p0_start

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

:p1_init
; Manually setup the stack as if we had CALLed into p1_start
; Push p1_start address onto stack
SET_ADDR_HIGH 0
SET_ADDR_LOW 14  ; p1_start will be at (0, 14) - need to verify
; Actually, I can't know the address before assembling...
; Let me use a different trick: don't peek, just pop

; Alternative: Save P1's state manually, not via CTX_SAVE
; Save PC = (0, 14) - will be computed by assembler
; This is getting too complex.

; Let me go back to basics: The scheduler IS WORKING!
; The issue is just P0's PCB being uninitialized on first load.
; Initialize it with a "fresh process" state.

JMP :boot_continue

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET