; scheduler_call_init.glyph - Use CALL for init so RET works

VECTOR 1 :scheduler_isr

:boot
; Initialize SP to 0
SET 0
STORE (3, 0)

; Initialize P0's PCB by CALLing its init
CALL :p0_init_save

; Initialize P1's PCB by CALLing its init
CALL :p1_init_save

; Boot complete - set PID and enable interrupts, start P0
SET 0
STORE (100, 0)
SEI
CTX_LOAD (20, 240)  ; Load P0

; --- PROCESS 0 ---
:p0_start
LOAD (50, 0)
ADD 10
STORE (50, 0)
JMP :p0_start

:p0_init_save
; Jump to p0_start, then CALL back here to CTX_SAVE
JMP :p0_start

; --- PROCESS 1 ---
:p1_start
LOAD (60, 0)
ADD 1
STORE (60, 0)
JMP :p1_start

:p1_init_save
; Jump to p1_start, then CALL back here to CTX_SAVE
JMP :p1_start

; --- SCHEDULER MICROKERNEL ---
:scheduler_isr
; Interrupt pushed return address to stack. POP it before CTX_LOAD.
POP

LOAD (100, 0)
SUB 0
JZ :switch_to_p1

:switch_to_p0
; P1 was running. Save P1, Load P0.
CTX_SAVE (30, 240)
CTX_LOAD (20, 240)
SET 0
STORE (100, 0)
RET

:switch_to_p1
; P0 was running. Save P0, Load P1.
CTX_SAVE (20, 240)
CTX_LOAD (30, 240)
SET 1
STORE (100, 0)
RET