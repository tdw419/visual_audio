  "source_code": "\ndef factorial(n):\n    if n <= 1:\n        return 1\n    return n * factorial(n - 1)\n\ndef fibonacci(n):\n    if n <= 1:\n        return n\n    return fibonacci(n - 1) + fibonacci(n - 2)\n\nprint(f\"factorial(5) = {factorial(5)}\")\nprint(f\"fibonacci(10) = {fibonacci(10)}\")\n",
